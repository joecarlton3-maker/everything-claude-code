//@version=5
// =============================================================================
// IB Breakout Extension Strategy  (NQ / ES / YM)
// -----------------------------------------------------------------------------
// Trades the Initial Balance (first hour of RTH) breakout on US index futures
// using IB-range extensions as profit targets.
//
// Concept
//   * IB = high/low of 09:30-10:30 ET (configurable).
//   * After IB completes, two stop entries are armed in an OCA group:
//        - Long  stop at IB high  (breakout)
//        - Short stop at IB low   (breakdown)
//     Whichever fills first becomes the trade; the other is canceled.
//   * If price later violates the OPPOSITE side of the IB, the day is
//     reclassified as a "double break" and the position is flattened.
//     (Double-break days have materially worse follow-through stats.)
//
// Targets are extensions of the IB range:
//        upper:  ib_high + (ib_high - ib_low) * mult
//        lower:  ib_low  - (ib_high - ib_low) * mult
//
// Empirical hit rates on single-break days (3-year lookback, edgeful.com):
//        Mult | NQ     | ES     | YM
//        0.2  | 87.5%  | 92.2%  | 86.3%
//        0.4  | 70.3%  | 77.7%  | 69.1%
//        0.6  | 52.1%  | 60.6%  | 51.2%
//        0.8  | 36.1%  | 52.4%  | 40.2%
//        1.0  | 25.2%  | 39.4%  | 29.2%
//
// First-hour day-classification stats (NQ, 3y):
//        single break: 75.78%   double break: 21.24%   no break: 2.98%
//
// Defaults are tuned for these probabilities: scale out faster on the
// high-probability inner targets and leave a runner for 1.0R extensions.
// =============================================================================

strategy("IB Breakout Extension Strategy",
     shorttitle      = "IB-BO-EXT",
     overlay         = true,
     initial_capital = 100000,
     default_qty_type   = strategy.percent_of_equity,
     default_qty_value  = 10,
     pyramiding         = 0,
     process_orders_on_close = false,
     calc_on_order_fills     = false,
     commission_type  = strategy.commission.percent,
     commission_value = 0.005)

// -----------------------------------------------------------------------------
// Inputs
// -----------------------------------------------------------------------------
grpSession = "Session"
ibSess  = input.session("0930-1030", "Initial Balance Window", group = grpSession)
rthSess = input.session("0930-1600", "RTH Window",             group = grpSession)
sessTz  = input.string ("America/New_York", "Timezone",        group = grpSession)

grpDir      = "Trade Direction"
tradeLongs  = input.bool(true, "Take Breakout Longs",   group = grpDir)
tradeShorts = input.bool(true, "Take Breakdown Shorts", group = grpDir)

grpTgt = "Targets (IB-Range Extensions)"
useT1 = input.bool (true, "Use 0.2 Target", group = grpTgt, inline = "t1")
m1    = input.float(0.2,  "Mult",           group = grpTgt, inline = "t1", step = 0.1)
p1    = input.float(20,   "% Out",          group = grpTgt, inline = "t1", step = 5)

useT2 = input.bool (true, "Use 0.4 Target", group = grpTgt, inline = "t2")
m2    = input.float(0.4,  "Mult",           group = grpTgt, inline = "t2", step = 0.1)
p2    = input.float(25,   "% Out",          group = grpTgt, inline = "t2", step = 5)

useT3 = input.bool (true, "Use 0.6 Target", group = grpTgt, inline = "t3")
m3    = input.float(0.6,  "Mult",           group = grpTgt, inline = "t3", step = 0.1)
p3    = input.float(20,   "% Out",          group = grpTgt, inline = "t3", step = 5)

useT4 = input.bool (true, "Use 0.8 Target", group = grpTgt, inline = "t4")
m4    = input.float(0.8,  "Mult",           group = grpTgt, inline = "t4", step = 0.1)
p4    = input.float(20,   "% Out",          group = grpTgt, inline = "t4", step = 5)

useT5 = input.bool (true, "Use 1.0 Target", group = grpTgt, inline = "t5")
m5    = input.float(1.0,  "Mult",           group = grpTgt, inline = "t5", step = 0.1)
p5    = input.float(15,   "% Out",          group = grpTgt, inline = "t5", step = 5)

grpRisk = "Risk Management"
stopType = input.string("IB Opposite", "Stop Loss Anchor",
     options = ["IB Opposite", "IB Mid", "Custom % of IB"], group = grpRisk)
stopPctIB = input.float(0.5, "Custom Stop (x IB Range)", step = 0.1, group = grpRisk)
flattenOnDouble = input.bool(true, "Flatten on Double Break", group = grpRisk)
useBE  = input.bool(true, "Move Stop to Breakeven", group = grpRisk,
     tooltip = "After the trigger tier fills, move the stop for all remaining exits to the entry price.")
beTier = input.int(2, "BE Trigger Tier (1-5)", minval = 1, maxval = 5, group = grpRisk)
exitMinsBefore  = input.int(15, "Flatten N Minutes Before Close", minval = 0, group = grpRisk)

grpFilter = "Filters"
minIBRangePct = input.float(0.0, "Min IB Range (% of price)", step = 0.05, group = grpFilter,
     tooltip = "Skip trades when the IB range is too tight. Larger ranges historically have lower double-break rates.")
maxIBRangePct = input.float(5.0, "Max IB Range (% of price)", step = 0.05, group = grpFilter)

grpView     = "Visualization"
showIB      = input.bool(true, "Draw IB High/Low/Mid", group = grpView)
showTargets = input.bool(true, "Draw Target Levels",   group = grpView)
showStats   = input.bool(true, "Show Probability Labels", group = grpView)
sym         = input.string("NQ", "Probability Profile",
     options = ["NQ", "ES", "YM"], group = grpView)

// -----------------------------------------------------------------------------
// Session detection
// -----------------------------------------------------------------------------
inIB  = not na(time(timeframe.period, ibSess,  sessTz))
inRTH = not na(time(timeframe.period, rthSess, sessTz))

ibStart   = inIB  and not inIB[1]
ibFinish  = not inIB and inIB[1]
rthStart  = inRTH and not inRTH[1]
rthFinish = not inRTH and inRTH[1]

// -----------------------------------------------------------------------------
// IB tracking
// -----------------------------------------------------------------------------
var float ibHigh   = na
var float ibLow    = na
var float ibMid    = na
var float ibRange  = na
var bool  ibLocked = false

if ibStart
    ibHigh   := high
    ibLow    := low
    ibLocked := false
else if inIB
    ibHigh := math.max(ibHigh, high)
    ibLow  := math.min(ibLow,  low)

if ibFinish
    ibMid    := (ibHigh + ibLow) / 2.0
    ibRange  := ibHigh - ibLow
    ibLocked := true

// -----------------------------------------------------------------------------
// Extension target prices
// -----------------------------------------------------------------------------
upL1 = ibLocked ? ibHigh + ibRange * m1 : na
upL2 = ibLocked ? ibHigh + ibRange * m2 : na
upL3 = ibLocked ? ibHigh + ibRange * m3 : na
upL4 = ibLocked ? ibHigh + ibRange * m4 : na
upL5 = ibLocked ? ibHigh + ibRange * m5 : na

dnL1 = ibLocked ? ibLow - ibRange * m1 : na
dnL2 = ibLocked ? ibLow - ibRange * m2 : na
dnL3 = ibLocked ? ibLow - ibRange * m3 : na
dnL4 = ibLocked ? ibLow - ibRange * m4 : na
dnL5 = ibLocked ? ibLow - ibRange * m5 : na

// -----------------------------------------------------------------------------
// Day classification state (break tracking runs AFTER entry arming below so
// a first-post-IB bar that already exceeds the IB can still arm the entry)
// -----------------------------------------------------------------------------
var bool brokeAbove  = false
var bool brokeBelow  = false
var bool doubleBreak = false
var bool beActive    = false

if rthStart
    brokeAbove  := false
    brokeBelow  := false
    doubleBreak := false
    beActive    := false

// -----------------------------------------------------------------------------
// Stop loss anchors
// -----------------------------------------------------------------------------
longStopPx  = stopType == "IB Opposite" ? ibLow  :
              stopType == "IB Mid"      ? ibMid  :
                                          ibHigh - ibRange * stopPctIB
shortStopPx = stopType == "IB Opposite" ? ibHigh :
              stopType == "IB Mid"      ? ibMid  :
                                          ibLow  + ibRange * stopPctIB

// -----------------------------------------------------------------------------
// Range filter
// -----------------------------------------------------------------------------
ibRangePct = ibLocked ? (ibRange / close) * 100.0 : na
rangeOK    = ibLocked and ibRangePct >= minIBRangePct and ibRangePct <= maxIBRangePct

// -----------------------------------------------------------------------------
// EOD time guard
// -----------------------------------------------------------------------------
hourMin    = hour(time, sessTz) * 60 + minute(time, sessTz)
closeMin   = 16 * 60 - exitMinsBefore
flattenEOD = inRTH and hourMin >= closeMin

// -----------------------------------------------------------------------------
// Entry orders (OCA stop entries armed once IB is locked)
// -----------------------------------------------------------------------------
canArm = ibLocked and inRTH and not doubleBreak and rangeOK and not flattenEOD and strategy.position_size == 0

if canArm
    if tradeLongs and not brokeAbove
        strategy.entry("L", strategy.long, stop = ibHigh,
             oca_name = "IB_BR", oca_type = strategy.oca.cancel,
             comment  = "Breakout")
    if tradeShorts and not brokeBelow
        strategy.entry("S", strategy.short, stop = ibLow,
             oca_name = "IB_BR", oca_type = strategy.oca.cancel,
             comment  = "Breakdown")

// Cancel pending entry on the unused side as soon as we are filled
if strategy.position_size > 0
    strategy.cancel("S")
if strategy.position_size < 0
    strategy.cancel("L")

// -----------------------------------------------------------------------------
// Break tracking (runs AFTER entry arming so the first post-IB bar can still
// arm its entry even when its own high/low already crosses the IB level)
// -----------------------------------------------------------------------------
if ibLocked and inRTH
    if high > ibHigh
        brokeAbove := true
    if low < ibLow
        brokeBelow := true
    if brokeAbove and brokeBelow
        doubleBreak := true

// Once the day flips to a double break, kill any still-pending stop entries
// so they cannot fire on a later bar.
if doubleBreak
    strategy.cancel("L")
    strategy.cancel("S")

// -----------------------------------------------------------------------------
// Breakeven stop detection
// -----------------------------------------------------------------------------
if useBE and not beActive and strategy.position_size != 0
    bePxLong  = beTier == 1 ? upL1 : beTier == 2 ? upL2 : beTier == 3 ? upL3 : beTier == 4 ? upL4 : upL5
    bePxShort = beTier == 1 ? dnL1 : beTier == 2 ? dnL2 : beTier == 3 ? dnL3 : beTier == 4 ? dnL4 : dnL5
    if strategy.position_size > 0 and high >= bePxLong
        beActive := true
    if strategy.position_size < 0 and low <= bePxShort
        beActive := true

entryPx = strategy.opentrades.size > 0 ? strategy.opentrades.entry_price(0) : na
activeLongStop  = useBE and beActive ? entryPx : longStopPx
activeShortStop = useBE and beActive ? entryPx : shortStopPx

// -----------------------------------------------------------------------------
// Scaled exits
// -----------------------------------------------------------------------------
if strategy.position_size > 0
    if useT1
        strategy.exit("X1L", from_entry = "L", limit = upL1, stop = activeLongStop, qty_percent = p1)
    if useT2
        strategy.exit("X2L", from_entry = "L", limit = upL2, stop = activeLongStop, qty_percent = p2)
    if useT3
        strategy.exit("X3L", from_entry = "L", limit = upL3, stop = activeLongStop, qty_percent = p3)
    if useT4
        strategy.exit("X4L", from_entry = "L", limit = upL4, stop = activeLongStop, qty_percent = p4)
    if useT5
        strategy.exit("X5L", from_entry = "L", limit = upL5, stop = activeLongStop, qty_percent = p5)

if strategy.position_size < 0
    if useT1
        strategy.exit("X1S", from_entry = "S", limit = dnL1, stop = activeShortStop, qty_percent = p1)
    if useT2
        strategy.exit("X2S", from_entry = "S", limit = dnL2, stop = activeShortStop, qty_percent = p2)
    if useT3
        strategy.exit("X3S", from_entry = "S", limit = dnL3, stop = activeShortStop, qty_percent = p3)
    if useT4
        strategy.exit("X4S", from_entry = "S", limit = dnL4, stop = activeShortStop, qty_percent = p4)
    if useT5
        strategy.exit("X5S", from_entry = "S", limit = dnL5, stop = activeShortStop, qty_percent = p5)

// -----------------------------------------------------------------------------
// Forced exits: double break + EOD
// Cancel bracket orders FIRST so strategy.exit doesn't block close_all
// -----------------------------------------------------------------------------
if flattenOnDouble and doubleBreak and strategy.position_size != 0
    strategy.cancel_all()
    strategy.close_all(comment = "Double Break")

if flattenEOD and strategy.position_size != 0
    strategy.cancel_all()
    strategy.close_all(comment = "EOD")

if rthFinish
    strategy.cancel_all()

// -----------------------------------------------------------------------------
// Visualization
// -----------------------------------------------------------------------------
plot(showIB and ibLocked ? ibHigh : na, "IB High",
     color = color.new(color.aqua, 0), linewidth = 2, style = plot.style_linebr)
plot(showIB and ibLocked ? ibLow : na, "IB Low",
     color = color.new(color.fuchsia, 0), linewidth = 2, style = plot.style_linebr)
plot(showIB and ibLocked ? ibMid : na, "IB Mid",
     color = color.new(color.gray, 0), linewidth = 1, style = plot.style_linebr)

plot(showTargets and useT1 and ibLocked ? upL1 : na, "+0.2",
     color = color.new(color.lime, 20), style = plot.style_linebr)
plot(showTargets and useT2 and ibLocked ? upL2 : na, "+0.4",
     color = color.new(color.lime, 35), style = plot.style_linebr)
plot(showTargets and useT3 and ibLocked ? upL3 : na, "+0.6",
     color = color.new(color.lime, 50), style = plot.style_linebr)
plot(showTargets and useT4 and ibLocked ? upL4 : na, "+0.8",
     color = color.new(color.lime, 60), style = plot.style_linebr)
plot(showTargets and useT5 and ibLocked ? upL5 : na, "+1.0",
     color = color.new(color.lime, 70), style = plot.style_linebr)

plot(showTargets and useT1 and ibLocked ? dnL1 : na, "-0.2",
     color = color.new(color.red, 20), style = plot.style_linebr)
plot(showTargets and useT2 and ibLocked ? dnL2 : na, "-0.4",
     color = color.new(color.red, 35), style = plot.style_linebr)
plot(showTargets and useT3 and ibLocked ? dnL3 : na, "-0.6",
     color = color.new(color.red, 50), style = plot.style_linebr)
plot(showTargets and useT4 and ibLocked ? dnL4 : na, "-0.8",
     color = color.new(color.red, 60), style = plot.style_linebr)
plot(showTargets and useT5 and ibLocked ? dnL5 : na, "-1.0",
     color = color.new(color.red, 70), style = plot.style_linebr)

bgcolor(doubleBreak ? color.new(color.orange, 90) : na, title = "Double Break Highlight")

// -----------------------------------------------------------------------------
// Probability labels at IB completion
// -----------------------------------------------------------------------------
get_prob(idx) =>
    p = 0.0
    if sym == "NQ"
        p := idx == 0 ? 87.5 : idx == 1 ? 70.3 : idx == 2 ? 52.1 : idx == 3 ? 36.1 : 25.2
    else if sym == "ES"
        p := idx == 0 ? 92.2 : idx == 1 ? 77.7 : idx == 2 ? 60.6 : idx == 3 ? 52.4 : 39.4
    else
        p := idx == 0 ? 86.3 : idx == 1 ? 69.1 : idx == 2 ? 51.2 : idx == 3 ? 40.2 : 29.2
    p

if showStats and ibFinish
    if useT1
        label.new(bar_index, upL1, "+0.2  " + str.tostring(get_prob(0), "#.#") + "%",
             style = label.style_label_left, color = color.new(color.green, 75),
             textcolor = color.white, size = size.tiny)
    if useT2
        label.new(bar_index, upL2, "+0.4  " + str.tostring(get_prob(1), "#.#") + "%",
             style = label.style_label_left, color = color.new(color.green, 75),
             textcolor = color.white, size = size.tiny)
    if useT3
        label.new(bar_index, upL3, "+0.6  " + str.tostring(get_prob(2), "#.#") + "%",
             style = label.style_label_left, color = color.new(color.green, 75),
             textcolor = color.white, size = size.tiny)
    if useT4
        label.new(bar_index, upL4, "+0.8  " + str.tostring(get_prob(3), "#.#") + "%",
             style = label.style_label_left, color = color.new(color.green, 75),
             textcolor = color.white, size = size.tiny)
    if useT5
        label.new(bar_index, upL5, "+1.0  " + str.tostring(get_prob(4), "#.#") + "%",
             style = label.style_label_left, color = color.new(color.green, 75),
             textcolor = color.white, size = size.tiny)
    if useT1
        label.new(bar_index, dnL1, "-0.2  " + str.tostring(get_prob(0), "#.#") + "%",
             style = label.style_label_left, color = color.new(color.maroon, 75),
             textcolor = color.white, size = size.tiny)
    if useT2
        label.new(bar_index, dnL2, "-0.4  " + str.tostring(get_prob(1), "#.#") + "%",
             style = label.style_label_left, color = color.new(color.maroon, 75),
             textcolor = color.white, size = size.tiny)
    if useT3
        label.new(bar_index, dnL3, "-0.6  " + str.tostring(get_prob(2), "#.#") + "%",
             style = label.style_label_left, color = color.new(color.maroon, 75),
             textcolor = color.white, size = size.tiny)
    if useT4
        label.new(bar_index, dnL4, "-0.8  " + str.tostring(get_prob(3), "#.#") + "%",
             style = label.style_label_left, color = color.new(color.maroon, 75),
             textcolor = color.white, size = size.tiny)
    if useT5
        label.new(bar_index, dnL5, "-1.0  " + str.tostring(get_prob(4), "#.#") + "%",
             style = label.style_label_left, color = color.new(color.maroon, 75),
             textcolor = color.white, size = size.tiny)
